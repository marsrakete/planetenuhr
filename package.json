{
  "name": "planetenuhr",
  "private": true,
  "version": "1.21.0",
  "description": "Static astronomy dashboard with build-time validation checks.",
  "scripts": {
    "check:encoding": "node scripts/check-encoding.js",
    "test:explorer": "node --test scripts/astronomy-explorer.test.js",
    "check:calendar-sources": "node scripts/check-calendar-sources.js",
    "check:calendar-sources:strict": "node scripts/check-calendar-sources.js --strict --check-links",
    "check:ics": "node scripts/check-ics-freshness.js",
    "review:calendar-sources": "npm run check:calendar-sources",
    "review:calendar-sources:strict": "npm run check:calendar-sources:strict",
    "repair:encoding": "node scripts/repair-mojibake.js",
    "build:ics": "node scripts/generate-ics.js",
    "generate:calendar-artifacts": "npm run build:ics",
    "validate:calendar-artifacts": "npm run check:ics",
    "refresh:calendar-artifacts": "npm run generate:calendar-artifacts && npm run validate:calendar-artifacts",
    "prebuild": "npm run check:encoding",
    "build": "node scripts/build.js",
    "validate:repo": "npm run build",
    "test:knowledge": "node --test scripts/sky-knowledge.test.js",
    "test:idefix": "node --test scripts/idefix.test.js",
    "test:typography": "node --test scripts/typography.test.js",
    "test:updates": "node --test scripts/app-updates.test.js",
    "test:voyager": "node --test scripts/voyager.test.js",
    "test:conjunctions": "node --test scripts/conjunctions.test.js",
    "test:daily": "node --test scripts/daily-highlights.test.js",
    "test:bodies": "node --test scripts/celestial-bodies.test.js"
  }
}
