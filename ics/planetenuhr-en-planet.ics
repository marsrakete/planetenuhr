END:VEVENT
BEGIN:VEVENT
UID:planetenuhr-en-planet-2027-01-03-venus-at-greatest-western-elongation@marsrakete.github.io
DTSTAMP:20260805T170001Z
DTSTART;VALUE=DATE:20270103
DTEND;VALUE=DATE:20270104
SUMMARY:Venus at greatest western elongation
CATEGORIES:PLANET
DESCRIPTION:Sichtbarkeit: Excellent morning visibility\n\nVenus is far from the Sun in the morning sky.
X-PLANETENUHR-VISIBILITY:Excellent morning visibility
END:VEVENT
BEGIN:VEVENT
UID:planetenuhr-en-planet-2027-05-08-venus-saturn-conjunction@marsrakete.github.io
DTSTAMP:20260805T170001Z
DTSTART;VALUE=DATE:20270508
DTEND;VALUE=DATE:20270509
SUMMARY:Venus-Saturn conjunction
CATEGORIES:PLANET
DESCRIPTION:Sichtbarkeit: Morning/eastern twilight\, low\n\nClose pairing\, but altitude and twilight may make the view challenging.
X-PLANETENUHR-VISIBILITY:Morning/eastern twilight\, low
END:VEVENT
